FLASK_SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/flask_chat
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
AVAILABLE_MODELS=Qwen3.7-Max,deepseek-v4-pro,doubao-seed-2.1-pro
MAX_CONTEXT_TOKENS=4000
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIM=4096
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5

# RAG Advanced (高级检索)
RAG_HYBRID_ENABLED=true
RAG_BM25_WEIGHT=0.3
RAG_VECTOR_WEIGHT=0.7
RAG_QUERY_REWRITE_ENABLED=false
RAG_RERANK_ENABLED=false

# File Upload
UPLOAD_FOLDER=uploads
IMAGE_UPLOAD_FOLDER=uploads/images
MAX_CONTENT_LENGTH=52428800

# Tools (工具配置)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
CODE_EXEC_ENABLED=true
CODE_EXEC_TIMEOUT=10
SEARCH_MAX_RESULTS=5
# Tavily API Key (可选，免费 1000 次/月，最稳定): https://tavily.com
TAVILY_API_KEY=

# Security (安全)
API_KEY=
INPUT_FILTER_ENABLED=true

# Cache (缓存优化)
CACHE_ENABLED=true
CACHE_TTL_HOURS=1
CACHE_MAX_SIZE=1000

# Retry & Fallback (重试与降级)
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
FALLBACK_MODEL=gpt-3.5-turbo

# Answer Verification (回答验证)
VERIFY_ENABLED=false
VERIFY_MODEL=

# LangSmith Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=flask_chat
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# AI Disclaimer (AI免责声明)
# AI_DISCLAIMER_TEXT=marin的大模型
